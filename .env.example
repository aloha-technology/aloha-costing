# Copy to .env and fill in from Supabase: Project Settings -> API (Data API / API Keys).
# .env is git-ignored. Never commit it.

# Used by the browser app (safe to be public; row-level security protects the data)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Used only by scripts on your computer (publish, users). SECRET: full database access.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
